# ---------
# Local developer environment (.env)
# ---------
# This file is used by the Python scripts in the repo root:
# - upload_vectors_to_vectorize.py
# - verify_vectorize_index.py
# - evaluate_retrieval.py
#
# Copy to .env and fill in values. Do NOT commit .env.
#
# Note: the Cloudflare Worker uses *different* env var names (ACCOUNT_ID, API_TOKEN, VECTORIZE_INDEX)
# and they should be set via `wrangler secret put ...`. See README.md.

# ---- Cloudflare Vectorize (for Python scripts)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_VECTORIZE_INDEX=
CLOUDFLARE_API_TOKEN=

# ---- Local dataset
# Folder containing images to ingest/evaluate. Can be flat or nested.
DATA_FOLDER=data

# ---- Ingestion tuning (upload_vectors_to_vectorize.py)
# How many images to embed per model inference batch.
EMBED_BATCH_SIZE=8
# How many vectors to send per Vectorize upsert HTTP call.
# Keep small; each vector is 768 floats and payload can hit 413 quickly.
UPLOAD_BATCH_SIZE=5

# Optional: only ingest first N images (string or integer). Leave blank for all images.
MAX_IMAGES=
# Optional: resume ingestion starting at offset N (integer).
START_AT=0

# ---- Evaluation (evaluate_retrieval.py)
# Override the model used in evaluation (ingestion script currently pins its model).
DINO_MODEL=facebook/dinov3-vitb16-pretrain-lvd1689m
# Number of query images to sample/evaluate.
MAX_QUERIES=200
# Comma-separated list of k values (e.g. "1,5,10,20").
TOPKS=1,5,10,20
# Vectorize returnMetadata mode for query calls: none | indexed | all
RETURN_METADATA=all
