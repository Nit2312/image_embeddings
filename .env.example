# NEVER commit real secrets. Copy to .env locally.

DATA_FOLDER=data

# --- Cloudflare Vectorize (REST uploader) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_VECTORIZE_INDEX=
CLOUDFLARE_API_TOKEN=

# --- Uploader tuning ---
# Smaller upload batches avoid Cloudflare 413 (payload too large).
EMBED_BATCH_SIZE=8
UPLOAD_BATCH_SIZE=5

